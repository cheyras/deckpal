# ── secrets ───────────────────────────────────────────────────────────────
# One rule for every dotenv variant (.env, .env.local, .env.cloud, and the
# .env.local that `vercel link` regenerates), with the committed template
# negated back in — mirroring the same pair in .vercelignore.
.env*
!.env.example
*.secret

# ── node / build ──────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
**/package-lock.json

# ── logs ──────────────────────────────────────────────────────────────────
*.log
**/logs/
*.jsonl

# ── image cache + fetched assets (never committed — DECISIONS.md 2026-07-24) ─
cache/
image-cache/
**/cache/cards/
**/cache/sets/
assets/sprites/
**/*.webp
**/*.avif

# The local cache root, machine-local in its entirety: IMAGE_CACHE_ROOT defaults
# to .cache/card-art, warm:cloud writes its resumable progress + residue here
# (apps/images/src/cloudWarm.ts), and one-off research probes land here too.
# Nothing under it has ever been tracked. The art itself is also covered by
# **/*.webp above; this rule is what keeps the bookkeeping out.
.cache/

# Marketing imagery is the exception: these are a small, deliberately committed set
# of original AI-generated landing-page assets (see apps/web/public/marketing/CREDITS.md).
# Without these negations the blanket **/*.webp and **/*.avif rules above would
# silently swallow every optimised asset scripts/gen-marketing-images.mjs produces.
!apps/web/public/marketing/
!apps/web/public/marketing/*.webp
!apps/web/public/marketing/*.avif

# And so is Deck-E's card back, for exactly the same reason and with exactly the
# same failure when it is missing. `**/*.webp` above swallowed it silently: `git
# add -A` reported nothing, the commit looked complete, the local build worked
# (the file was on disk), CI passed, and it 404'd only in production — where the
# character's cards would have shown the AI-generated placeholder back forever.
# The other assets in that directory are .glb/.json/.hdr/.png and were never
# caught by the rule, which is what made it look like a routing problem.
!apps/web/public/models/decke/
!apps/web/public/models/decke/*.webp

# Raw, full-size generations from scripts/gen-marketing-images.mjs — originals and
# rejected candidates. Only the optimised derivatives get committed.
.marketing-raw/

# ── transient catalog extract (docker save | tar output) ──────────────────
extract/
*.tar

# ── runtime catalog data dir (the importer reads compiled JSON from here) ───
# Ignore data/* contents but re-include the vendored PokeAPI species CSVs, which ARE
# committed (BSD-3, ~216 KB, static — DEX-DATA.md §B.3). Sprites are NOT here (fetched).
data/*
!data/pokeapi/

# ── backups + exports (never committed; live outside the repo by default) ──
# Defensive: if a backup/export is ever pointed inside the repo, don't commit it.
deckpal-backups/
deckpal-exports/
pokedex-backups/
pokedex-exports/
*.dump

# ── os cruft ──────────────────────────────────────────────────────────────
.DS_Store

# ── deploy artifacts ─────────────────────────────────────────────────────
# Intentionally untracked, not just deleted — harmless if someone recreates
# deploy/ locally for their own self-host setup.
deploy/

# ── design-system editor request queue (dev-only, never committed) ───────
/design-requests/

# ── machine-local agent instructions (not portable) ─────────────────────
CLAUDE.local.md
.vercel

# ── agent scheduler state (live session state, never committed) ──────────
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# ── credentials ──────────────────────────────────────────────────────────
# .qa-account holds the shared QA login used to verify the DEPLOYED site (every
# app route sits behind the Supabase auth guard, so there is no other way to see
# production signed in). Ignored ahead of anything else claiming a dot-prefixed
# credential name, because the failure mode is a live password in a public repo.
.qa-account
.owner-temp-password

# The Google service-account key for tools/drive-export. Its path comes from
# DRIVE_EXPORT_CREDENTIALS; this is the default that tool names in its own
# error message, so it is the path somebody will actually create. A
# service-account key is a live private key, not a config file.
.drive-export-credentials.json

# ── supabase CLI scratch (link state, not portable) ───────────────────────
supabase/.temp/


# ── favicon preview sheet (scripts/gen-favicon.mjs --preview) ────────────
.favicon-preview.png

# Python bytecode from the scripts/decke generators
__pycache__/
*.pyc

# ── crash dumps (a killed node process can drop a multi-GB core here) ─────
core.*

# Generated review rendering of DECKE-AGENT-SPEC.md (see .cache/decke-probe/build_spec_html.py)
.decke-spec-review.html
.gate-shots/
.vercel-bypass
.preview-url

# ── visual-verification harness artifacts (scripts/visual-harness) ───────
# Screenshots, videos, contact sheets, and JSON reports from a run. Same
# convention as .gate-shots/ above: operator-produced evidence, never
# committed, regenerated on demand.
.visual-harness/

# Deck-E optimization candidates for /dev/decke-compare. Build artifacts, not
# source: regenerate with `apps/web/scripts/decke/optimize.mjs` (see that file's
# header). The SHIPPED asset, `decke.glb`, is tracked and must stay tracked.
apps/web/public/models/decke/decke.opt.glb
apps/web/public/models/decke/decke.min.glb

# The pre-optimization Deck-E glb, kept so /dev/decke-compare has something to
# compare against. Recoverable from git history either way (DECISIONS.md
# 2026-08-24); this is just convenience.
apps/web/public/models/decke/decke.orig.glb
