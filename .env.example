# DeckScout — environment template
# Copy to .env and fill in real values. Never commit .env.
# Load before DB/script work: set -a && . ./.env && set +a

# -- Postgres ------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=deckscout
PGUSER=deckscout
PGPASSWORD=change-me

# -- Connection budget ----------------------------------------------------
# Cluster total: 4 (API 2 + sync 1 + MCP 1).
# Per-process hard cap: 3 (enforced by packages/db/src/pool.ts).
# One-off scripts should use 1 connection.
# Never raise past the cluster total without checking max_connections headroom.
PGPOOL_MAX_API=2
PGPOOL_MAX_SYNC=1
PGPOOL_MAX_MCP=1
PGPOOL_MAX=3

# -- Ports (bind 127.0.0.1 only; a reverse proxy is the sole ingress) ----
DECKSCOUT_API_PORT=3700
DECKSCOUT_IMAGES_PORT=3701
DECKSCOUT_MCP_PORT=3704

# -- Image cache ----------------------------------------------------------
# Absolute path to the WebP card-art cache.
# Layout: images/<lang>/<serie>/<set>/<localId>.<low|high>.webp
#         sets/<setId>/<logo|symbol>.webp
# See apps/images/src/layout.ts for the authoritative path contract.
IMAGE_CACHE_ROOT=/path/to/cache

# Absolute path to the Pokemon sprite directory (pixel art + official artwork).
SPRITE_ROOT=/path/to/assets/sprites/pokemon

# -- MCP server (rotom-mcp) ----------------------------------------------
# Key for x-brain-key header authentication.
ROTOM_MCP_KEY=generate-a-random-hex-string

# Comma-separated hostnames allowed to connect to the MCP server.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# -- API base URL (used by sync jobs and MCP to reach the API) ------------
DECKSCOUT_API_BASE=http://127.0.0.1:3700/deckscout/api

# -- Default user ---------------------------------------------------------
# Username for the single-user collection owner (used by importers).
DECKSCOUT_DEFAULT_USER=your-username

# -- CORS (optional) ------------------------------------------------------
# Comma-separated origin allowlist for the API. Leave unset when the SPA is
# served by the API itself (same-origin, CORS not needed). Set only if you
# host the SPA separately.
# API_CORS_ORIGINS=http://localhost:5173

# -- ImageMagick (optional) -----------------------------------------------
# Path to the ImageMagick binary used by the perceptual-hash scanner.
# Defaults to 'magick' on PATH.
# IMAGEMAGICK_BIN=magick

# -- Data directories (optional, for sync CLI) ----------------------------
# Override where catalog and PokeAPI JSON are read from.
# CATALOG_DATA_DIR=/path/to/data/catalog/en
# POKEAPI_DATA_DIR=/path/to/data/pokeapi

# -- pkmn.gg image warmer (optional) -------------------------------------
# Path to a pkmn.gg auth/session JSON file for the image warmer.
# Only needed if you run the pkmn.gg warm script.
# PKMN_AUTH=/path/to/pkmn-auth.json

# -- Dev (optional) -------------------------------------------------------
# Port the Vite dev proxy targets (default 3700, the API).
# Set when running a branch-specific API instance.
# DECKSCOUT_DEV_API_PORT=3700
