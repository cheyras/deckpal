# DeckPal — environment template
# Copy to .env and fill in real values. Never commit .env.
# Load before DB/script work: set -a && . ./.env && set +a

# ── Supabase (cloud deployment) ──────────────────────────────────────────
# Leave these unset for self-host (plain Postgres) deployments.

# Set to 1 to enable Supabase-only migrations (021+) and per-request RLS
# context (SET LOCAL role = 'authenticated'). Leave unset for self-host.
# SUPABASE_MODE=1

# Public keys (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Vite SPA client-side keys (the Vite equivalents of NEXT_PUBLIC_ above).
# These are what the SPA actually reads at build time.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Server-side only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT verification. New Supabase projects sign tokens with ES256 (JWT Signing
# Keys) — the API verifies them via the project's JWKS endpoint at
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json, so no extra secret is needed.
# SUPABASE_JWT_SECRET is only required for legacy HS256 projects or self-hosted
# Supabase instances that still use a shared secret.
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Direct connection (for migrations — not pooled)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Pooled connection (for API serverless functions — transaction mode)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Postgres ─────────────────────────────────────────────────────────────
# Set these for BOTH self-host and cloud dev. For Supabase, PGHOST is the
# Supavisor pooler host and PGPORT is its SESSION port (5432).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=deckpal
PGUSER=deckpal
PGPASSWORD=change-me

# Supabase only. Supavisor serves TRANSACTION pooling on 6543 for the same
# host. pool.ts routes the API's request pool here automatically whenever
# PGHOST is a *.pooler.supabase.com address, so you normally leave this unset.
# Migrations, sync jobs and the MCP server deliberately keep using PGPORT:
# their advisory locks and TEMPORARY tables need a session-scoped connection.
# PGPORT_TRANSACTION=6543

# ── Connection budget ────────────────────────────────────────────────────
# LEAVE THESE UNSET unless you are deploying onto a Postgres you must ration.
# pool.ts picks sane sizes per role and per backend: the API's request pool
# gets real concurrency (its max IS the max concurrent requests when
# SUPABASE_MODE is on), and workers stay at 1. Setting PGPOOL_MAX_API too low
# is how you get "the backend won't connect" — a single page load issues more
# parallel calls than a pool of 2 can serve. See DECISIONS.md 2026-08-11.
#
# The reference self-host box (max_connections=20, shared with other apps)
# pins them like this:
# PGPOOL_MAX_API=2
# PGPOOL_MAX_SYNC=1
# PGPOOL_MAX_MCP=1
# PGPOOL_MAX=3

# ── Bug reporter → GitHub issues (cloud deployment) ─────────────────────
# Create a fine-grained PAT (github.com/settings/personal-access-tokens)
# with "Issues: Read and write" on the target repo.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=cheyras/deckpal

# Server-side Supabase project URL (used by the bug reporter for screenshot
# uploads to Supabase Storage). Falls back to NEXT_PUBLIC_SUPABASE_URL if unset.
# SUPABASE_URL=https://<project>.supabase.co

# ── API configuration ───────────────────────────────────────────────────
API_BASE_PATH=/api
NODE_ENV=production

# ── Image storage ────────────────────────────────────────────────────────
# Self-host only: absolute path to the WebP card-art cache.
# Cloud deployments use Supabase Storage (card-art bucket).
IMAGE_CACHE_ROOT=/path/to/cache

# Absolute path to the Pokemon sprite directory (pixel art + official artwork).
SPRITE_ROOT=/path/to/assets/sprites/pokemon

# ── MCP server (deckpal-mcp) ──────────────────────────────────────────────
# Key for x-brain-key header authentication (self-host / Wave 3 cloud).
DECKPAL_MCP_KEY=generate-a-random-hex-string

# Comma-separated hostnames allowed to connect to the MCP server.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Self-host ports (bind 127.0.0.1; reverse proxy is the sole ingress) ─
# Ignored for cloud deployments (Vercel handles routing).
DECKPAL_API_PORT=3700
DECKPAL_IMAGES_PORT=3701
DECKPAL_MCP_PORT=3704

# ── API base URL (used by sync jobs and MCP to reach the API) ───────────
DECKPAL_API_BASE=http://127.0.0.1:3700/api

# ── Default user (self-host single-user mode) ───────────────────────────
# Username for the single-user collection owner (used by importers).
# Cloud deployments use Supabase Auth UUIDs instead.
DECKPAL_DEFAULT_USER=your-username

# ── CORS (optional) ─────────────────────────────────────────────────────
# Comma-separated origin allowlist. Leave unset when the SPA is served by
# the API itself (same-origin, CORS not needed).
# API_CORS_ORIGINS=http://localhost:5173

# ── ImageMagick (optional — scanner, self-host only) ─────────────────────
# Path to the ImageMagick binary used by the perceptual-hash scanner.
# IMAGEMAGICK_BIN=magick

# ── Data directories (optional, for sync CLI) ───────────────────────────
# Override where catalog and PokeAPI JSON are read from.
# CATALOG_DATA_DIR=/path/to/data/catalog/en
# POKEAPI_DATA_DIR=/path/to/data/pokeapi

# ── Dev (optional) ──────────────────────────────────────────────────────
# NOTE: `pnpm dev` needs NONE of this file. It runs the web app against the
# live deckpal.app backend and fetches the public Supabase config from
# /api/public-config at startup. This file is only for `pnpm dev --local`,
# which runs your own API, database and image tier. See AGENTS.md B12.
#
# Deployment the dev server proxies to (default https://deckpal.app). Point it
# at a Vercel preview URL or your own fork's deployment.
# DECKPAL_DEV_ORIGIN=https://deckpal.app
#
# Force the full local stack (same as `pnpm dev --local`).
# DECKPAL_DEV_BACKEND=local
#
# Port the Vite dev proxy targets in local mode (default 3700, the API).
# Setting this selects local mode automatically — a worktree lane running its
# own API must not be silently proxied to production.
# DECKPAL_DEV_API_PORT=3700
#
# Allow POST /api/bugs from the dev server. Blocked by default: it opens a real
# issue on the real GitHub tracker.
# DECKPAL_DEV_ALLOW_BUGS=1

# ── Deck-E (the in-app assistant) ───────────────────────────────────────────
#
# The Vercel AI Gateway key POST /api/chat uses. Unset means Deck-E's chat is
# off and every request to it 503s — fail-closed, and reported: the API warns
# on boot and returns `deckeGate` on GET /health.
#
# IT NEEDS PAID CREDITS. A free-tier key authenticates, lists every model, and
# then returns a bare 429 on all of them, with no retry-after header to back
# off against.
#
# Deliberately NOT the same key as the marketing image generator's
# AI_GATEWAY_API_KEY, so Deck-E's per-user spend stays legible on its own.
# Local dev falls back to AI_GATEWAY_API_KEY when this is unset; production
# never falls back.
# DECKE_VERCEL_AI_GATEWAY_KEY=

# ── Stripe: the pay-what-you-want tier (cloud only) ──────────────────────
# All four are required together. Unset = the tier is OFF, which is a real
# intended configuration (self-host, previews) and is reported as
# billingGate: "unset" on /api/health. Having SOME of them is the dangerous
# state -- a secret key with no webhook secret takes cards and then never
# hears about a renewal, a failure or a cancellation again. /api/health
# calls that "partial" and the API warns about it by name on boot.
#
# Start in TEST mode: sk_test_/pk_test_ keys and a test-mode product. The UI
# shows a "Test mode -- no real charge" badge whenever the secret key's prefix
# says test, so the state is visible on the page. Card 4242 4242 4242 4242.
#
# The publishable key is PUBLIC and is served to the browser at runtime from
# GET /me/billing -- deliberately not baked in at build time, so the key in
# the browser and the key on the server can never be from different accounts
# or different modes.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# The one Stripe Product every supporter is billed against. No Price object:
# the amount is inline price_data per subscription (see apps/api/src/billing).
# STRIPE_SUPPORT_PRODUCT_ID=prod_...
# The webhook's ONLY authentication. POST /api/stripe/webhook is public by
# necessity (Stripe holds no session), so this signature check IS the access
# control on the endpoint that decides who is recorded as paying. Unset, the
# route 503s and processes nothing -- it never falls back to trusting the body.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional. Where Stripe's billing portal returns the reader to. Unset, it is
# derived from the request, which is right for every ordinary deployment.
# PUBLIC_APP_ORIGIN=https://deckpal.app
