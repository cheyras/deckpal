{
  "buildCommand": "pnpm --filter @deckpal/db build && pnpm --filter @deckpal/storage build && pnpm --filter deckpal-api build && pnpm --filter deckpal-mcp build && pnpm --filter deckpal-web build",
  "regions": [
    "sfo1"
  ],
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/deckpal/images/(.*)",
      "destination": "/api/images?p=$1"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/register",
      "destination": "/api"
    },
    {
      "source": "/token",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "apps/api/dist/deck/data/*.json"
    },
    "api/images.mjs": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/mcp.mjs": {
      "maxDuration": 60,
      "memory": 512,
      "includeFiles": "apps/mcp/{package.json,assets/icon-128.png}"
    }
  }
}
