{
  "buildCommand": "pnpm --filter @deckpal/db build && pnpm --filter @deckpal/storage build && pnpm --filter @deckpal/agent-tools build && pnpm --filter deckpal-api build && pnpm --filter deckpal-mcp build && pnpm --filter deckpal-web build",
  "regions": [
    "sfo1"
  ],
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "https://stripe.com/files/apple-pay/apple-developer-merchantid-domain-association",
      "permanent": false
    },
    {
      "source": "/:path((?!mcp(?:/|$)|api(?:/|$)|register$|token$|\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "deckscout.io"
        }
      ],
      "destination": "https://deckpal.app/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/decke/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/deckpal/images/(.*)",
      "destination": "/api/images?p=$1"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/register",
      "destination": "/api"
    },
    {
      "source": "/token",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/:path((?!.*\\.(?:png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|otf|css|js|mjs|map|txt|xml|json|webmanifest|glb|hdr|bin)$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "apps/api/dist/deck/data/*.json"
    },
    "api/images.mjs": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/mcp.mjs": {
      "maxDuration": 60,
      "memory": 512,
      "includeFiles": "apps/mcp/{package.json,assets/icon-128.png}"
    },
    "api/chat.mjs": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
