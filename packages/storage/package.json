{
  "name": "@deckpal/storage",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./src/paths.ts",
      "default": "./dist/paths.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/supabase-key-headers.mjs', 'dist/supabase-key-headers.mjs')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
