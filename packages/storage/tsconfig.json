{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // @types/node is needed for `process`, `Buffer` and `fetch`, and for the
    // `node:crypto` / `node:fs/promises` imports in avatar-store.ts and
    // put-asset.ts. Ask for it explicitly rather than relying on an implicit
    // pull-in.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
