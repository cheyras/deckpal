{
  "name": "deckpal-sync",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:pure": "node --import tsx --test src/prices/__tests__/*.test.ts",
    "start": "node dist/index.js",
    "run-once": "tsx src/run-once.ts",
    "import:catalog": "tsx src/catalog/cli.ts",
    "import:dex": "tsx src/dex/cli.ts",
    "prices": "tsx src/prices/cli.ts"
  },
  "dependencies": {
    "@deckpal/db": "workspace:*",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
