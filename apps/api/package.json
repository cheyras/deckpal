{
  "name": "deckscout-api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/deck/data','dist/deck/data',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test:deck": "node --import tsx --test src/deck/__tests__/*.test.ts",
    "test:collection": "node --import tsx --test src/__tests__/*.test.ts",
    "test:auth": "node --import tsx --test src/__tests__/auth.test.ts",
    "test:bugs": "node --import tsx --test src/__tests__/bugs.test.ts",
    "prove:deck": "node --import tsx src/deck/prove.ts",
    "scan:index": "node --import tsx src/scan/index.ts",
    "test:images": "node --import tsx --test src/images/__tests__/*.test.ts"
  },
  "dependencies": {
    "@deckscout/db": "workspace:*",
    "@deckscout/storage": "workspace:*",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
