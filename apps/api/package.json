{
  "name": "deckpal-api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/deck/data','dist/deck/data',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test:deck": "node --import tsx --test src/deck/__tests__/*.test.ts",
    "test:collection": "node --import tsx --test src/__tests__/*.test.ts",
    "test:auth": "node --import tsx --test src/__tests__/auth.test.ts src/__tests__/identity.test.ts",
    "test:tokens": "node --import tsx --test src/__tests__/tokens.test.ts",
    "test:bugs": "node --import tsx --test src/__tests__/bugs.test.ts",
    "prove:deck": "node --import tsx src/deck/prove.ts",
    "scan:index": "node --import tsx src/scan/index.ts",
    "test:images": "node --import tsx --test src/images/__tests__/*.test.ts",
    "test:pure": "node --import tsx --test src/__tests__/massentry.test.ts src/__tests__/mutations.test.ts src/__tests__/batch-fold.test.ts src/__tests__/soft-delete.test.ts src/__tests__/fingerprint-fold.test.ts src/__tests__/tokens.test.ts src/__tests__/bugs.test.ts",
    "test:decke": "node --import tsx --test src/decke/__tests__/*.test.ts",
    "fingerprint:index": "node --import tsx src/deck/indexFingerprints.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.63",
    "@deckpal/agent-tools": "workspace:*",
    "@deckpal/db": "workspace:*",
    "@deckpal/storage": "workspace:*",
    "ai": "7.0.78",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
