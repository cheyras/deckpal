{
  "name": "deckpal-api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const{cpSync}=require('fs');for(const d of ['deck','scan'])cpSync('src/'+d+'/data','dist/'+d+'/data',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test:deck": "node --import tsx --test src/deck/__tests__/*.test.ts",
    "test:collection": "node --import tsx --test src/__tests__/*.test.ts",
    "test:auth": "node --import tsx --test src/__tests__/auth.test.ts src/__tests__/identity.test.ts",
    "test:tokens": "node --import tsx --test src/__tests__/tokens.test.ts",
    "test:bugs": "node --import tsx --test src/__tests__/bugs.test.ts",
    "prove:deck": "node --import tsx src/deck/prove.ts",
    "scan:index": "node --import tsx src/scan/index.ts",
    "test:images": "node --import tsx --test src/images/__tests__/*.test.ts",
    "test:stripe-contract": "node ../../scripts/stripe-contract-check.mjs",
    "test:integration": "node ../../scripts/test-db-integration.mjs",
    "test:pure": "node --import tsx --test src/__tests__/massentry.test.ts src/__tests__/deck-diff.test.ts src/__tests__/list-rules.test.ts src/__tests__/mutations.test.ts src/__tests__/batch-fold.test.ts src/__tests__/soft-delete.test.ts src/__tests__/fingerprint-fold.test.ts src/__tests__/tokens.test.ts src/__tests__/bugs.test.ts src/__tests__/upcoming-sets.test.ts src/__tests__/upcoming-series.test.ts src/__tests__/upcoming-route.test.ts src/__tests__/dbHandle.test.ts src/__tests__/ownerGate.test.ts src/__tests__/billing.test.ts src/__tests__/billing-gate.test.ts src/scan/__tests__/fetchEmbedModel.test.ts src/scan/__tests__/printedSetCode.test.ts src/scan/__tests__/resolve.test.ts src/scan/__tests__/familyText.test.ts src/scan/__tests__/embedMatch.test.ts src/scan/__tests__/fuse.test.ts",
    "test:decke": "node --import tsx --test src/decke/__tests__/*.test.ts",
    "test:export": "node --import tsx --test src/export/__tests__/*.test.ts",
    "fingerprint:index": "node --import tsx src/deck/indexFingerprints.ts",
    "test:scan": "node --import tsx --test src/scan/__tests__/*.test.ts",
    "test:ratelimit": "node --import tsx --test src/__tests__/rateLimit.test.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.76",
    "@deckpal/agent-tools": "workspace:*",
    "@deckpal/db": "workspace:*",
    "@deckpal/matching": "workspace:*",
    "@deckpal/storage": "workspace:*",
    "ai": "7.0.94",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
