{
  "name": "deckpal-images",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "warm": "node dist/warmer.js",
    "warm:dev": "tsx src/warmer.ts",
    "warm:sets": "node dist/setWarmer.js",
    "warm:sets:dev": "tsx src/setWarmer.ts",
    "warm:gaps": "tsx src/warmGaps.ts",
    "evict": "node dist/evict.js",
    "evict:dev": "tsx src/evict.ts",
    "manifest:check": "tsx src/manifestCheck.ts",
    "rekey:set": "tsx src/rekeySet.ts",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "manifest:backfill": "tsx src/manifestBackfill.ts",
    "storage:backfill": "tsx src/cloudBackfill.ts",
    "warm:cloud": "tsx src/cloudWarm.ts"
  },
  "dependencies": {
    "@deckpal/db": "workspace:*",
    "@deckpal/storage": "workspace:*",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
