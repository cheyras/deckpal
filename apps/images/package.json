{
  "name": "deckscout-images",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "warm": "node dist/warmer.js",
    "warm:dev": "tsx src/warmer.ts",
    "warm:sets": "node dist/setWarmer.js",
    "warm:sets:dev": "tsx src/setWarmer.ts",
    "warm:gaps": "tsx src/warmGaps.ts",
    "warm:pkmn": "tsx src/warmFromPkmn.ts",
    "evict": "node dist/evict.js",
    "evict:dev": "tsx src/evict.ts",
    "manifest:check": "tsx src/manifestCheck.ts",
    "manifest:backfill": "tsx src/manifestBackfill.ts"
  },
  "dependencies": {
    "@deckscout/db": "workspace:*",
    "@deckscout/storage": "workspace:*",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
