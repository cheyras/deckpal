{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "deckpal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5199,
      "url": "http://localhost:5199"
    },
    {
      "name": "deckpal-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "deckpal-web",
        "preview",
        "--port",
        "5210",
        "--strictPort"
      ],
      "port": 5210,
      "url": "http://localhost:5210"
    },
    {
      "name": "deckpal-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "deckpal-web",
        "dev",
        "--host",
        "--port",
        "5299",
        "--strictPort"
      ],
      "port": 5299,
      "url": "http://localhost:5299"
    }
  ]
}
